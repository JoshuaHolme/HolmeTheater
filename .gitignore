# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Xcode
# ---------------------------------------------------------------------------

## Per-user state: window layout, breakpoints, scheme order, open files.
## (Shared schemes live in xcshareddata/ and stay tracked.)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

## Build output
build/
DerivedData/
*.hmap
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip

## Generated by Xcode and not needed in the repo
*.moved-aside
*.xcodeproj/project.xcworkspace/xcuserdata/

## Playgrounds
timeline.xctimeline
playground.xcworkspace

## Crash logs and profiling output
*.crash
*.trace
*.xcresult

# ---------------------------------------------------------------------------
# Swift Package Manager
# ---------------------------------------------------------------------------
# Package.resolved is intentionally NOT ignored: this is an app, so the exact
# dependency versions should be pinned and shared with contributors.
.build/
.swiftpm/
# Packages/

# ---------------------------------------------------------------------------
# Other dependency managers (not used today; here so adopting one doesn't
# accidentally commit its output)
# ---------------------------------------------------------------------------
Pods/
Carthage/Build/

# ---------------------------------------------------------------------------
# fastlane
# ---------------------------------------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ---------------------------------------------------------------------------
# Secrets and signing material: never commit these
# ---------------------------------------------------------------------------
.env
.env.*
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
