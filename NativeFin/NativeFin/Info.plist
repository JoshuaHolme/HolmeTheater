<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Jellyfin servers are self-hosted and very commonly served over plain HTTP on a LAN
		(e.g. http://192.168.1.10:8096), at addresses that aren't known when the app is built.
		Local networking lets HTTP through to IP addresses, .local names and single-label host names, which covers
		those, while everything else (a public host name) has to use HTTPS: the access token travels in the query of
		stream and subtitle URLs, so it shouldn't cross the internet in clear text. The sign-in flow still tries HTTPS
		first when the user doesn't type a scheme.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!--
		Without this, an iPhone with a 120 Hz display runs the app's animations at 60 fps at most, which shows as
		choppiness in anything that slides. Scrolling is smooth either way; it's the app's own animations it unlocks.
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Lets the progress of downloads show on the Lock Screen and in the Dynamic Island. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Lets video keep playing in Picture in Picture. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
